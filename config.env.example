TZ=Asia/Ho_Chi_Minh
FRIGATE_HOST=http://your-frigate-host:5000
TELEGRAM_API_URL=https://api.telegram.org
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
CAMERAS=FrontDoor|frontdoor|THREAD_ID|CHAT_ID
ERROR_CHAT_ID=YOUR_ERROR_CHAT_ID
ERROR_THREAD_ID=YOUR_ERROR_THREAD_ID
NOTIFY_ON_RECOVERY=true
PADDING_SEC=5
REC_DURATION_MIN=15
TEST_REC_DURATION_MIN=1
MODE=record
RETENTION_DAYS=30
ALERT_RETENTION_HOURS=72
ALERT_REPEAT=false
LOOKBACK_HOURS=24
MAX_CONCURRENT_TASKS=2
MAX_RETRIES=5

# Data directory inside the container (optional override)
DATA_DIR=./data

# VAAPI device for hardware-accelerated timelapse (optional)
VAAPI_DEVICE=/dev/dri/renderD128

# Timelapse settings
TIMELAPSE_HOURS=6
TIMELAPSE_SPEED=60
TIMELAPSE_FPS=30
TIMELAPSE_QUALITY=24
TIMELAPSE_LOOKBACK_HOURS=24
TIMELAPSE_STRICT_RETRY=true
TIMELAPSE_RETRY_SLEEP_SEC=3600