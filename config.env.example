# ==============================================================================
# GENERAL SETTINGS
# ==============================================================================
# Timezone for the system and log timestamps
TZ=Asia/Ho_Chi_Minh

# The base URL of your Frigate instance (internal IP usually works best)
FRIGATE_HOST=http://127.0.0.1:5000

# Telegram API URL (Default is official, change if using a local bot API server)
TELEGRAM_API_URL=https://api.telegram.org

# Directory to store database, logs, and temporary video clips
# Ensure this path is writable or mapped in Docker volumes
DATA_DIR=/app/data

# Temporary directory for processing video clips (RAM disk recommended for performance)
# Default uses shared memory for faster I/O operations
TEMP_DIR=/dev/shm/frigate_clips

# ==============================================================================
# TELEGRAM BOT AUTHENTICATION
# ==============================================================================
# Your Telegram Bot Token obtained from @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Chat ID where system errors and critical alerts will be sent
# Can be a user ID or a group ID (usually starts with -100 for supergroups)
ERROR_CHAT_ID=-1001234567890

# (Optional) Topic ID/Thread ID if sending errors to a specific forum topic
ERROR_THREAD_ID=

# ==============================================================================
# CAMERA CONFIGURATION
# ==============================================================================
# Format: DisplayName|frigate_camera_name|thread_id|chat_id
# Separator between parameters: |
# Separator between cameras: ;
# Note: thread_id can be left empty if not using topics, but separators must remain.
# Example: Front Door|front_door|10|12345;Back Yard|back_yard||12345
CAMERAS=Living Room|living_room|20|-1001234567890;Garage|garage||-100987654321

# ==============================================================================
# OPERATING MODE
# ==============================================================================
# Options: 
#   record         - Normal operation: cuts clips and sends them.
#   timelapse      - Generates and sends timelapses based on HLS vod.
#   test           - Runs one cycle of 'record' immediately then exits.
#   test_timelapse - Runs one cycle of 'timelapse' immediately then exits.
MODE=record

# Enable detailed debug logging (true/false)
# When enabled, logs database queries, HTTP responses, video validation steps, etc.
DEBUG=false

# ==============================================================================
# RECORDING MODE SETTINGS (Clips)
# ==============================================================================
# Duration of each video clip in minutes
REC_DURATION_MIN=15

# How far back (in hours) to scan for missing clips to fill gaps
LOOKBACK_HOURS=168

# ==============================================================================
# TIMELAPSE MODE SETTINGS
# ==============================================================================
# Duration of one timelapse block in hours (e.g., 6h of real time compressed)
TIMELAPSE_HOURS=6

# Speed multiplier (e.g., 60 means 1 minute of real time = 1 second of video)
TIMELAPSE_SPEED=600

# Output Frames Per Second for the timelapse video
TIMELAPSE_FPS=30

# Encoding Quality (CRF/QP). Lower is better quality, higher is smaller size.
TIMELAPSE_QUALITY=24

# Hardware Acceleration Device for FFmpeg (VAAPI)
# Check permissions: container needs access to /dev/dri/renderD128
VAAPI_DEVICE=/dev/dri/renderD128

# Chunk size in seconds for processing timelapse segments (default: 6900 = 115 minutes)
# Smaller chunks = more stable but slower, larger chunks = faster but may cause ffmpeg issues
TIMELAPSE_CHUNK_SIZE_SEC=6900

# How far back (in hours) to scan for missing timelapse blocks
TIMELAPSE_LOOKBACK_HOURS=720

# Retry Strategy for Timelapse:
# true:  If a block fails, sleep briefly (TIMELAPSE_RETRY_SLEEP_SEC) and retry immediately.
# false: If a block fails, log it and move to the next scheduled long sleep.
TIMELAPSE_STRICT_RETRY=false

# Seconds to wait before retrying a failed timelapse generation
TIMELAPSE_RETRY_SLEEP_SEC=3600

# (Optional) Global Thread ID for timelapses.
# If set, overrides the individual camera thread_id for timelapse videos only.
TIMELAPSE_THREAD_ID=33

# ==============================================================================
# ALERTS & NOTIFICATIONS
# ==============================================================================
# Percentage of expected duration required to consider a video "valid" (0-100)
# If a 15min clip is only 13min long, is it a success or fail?
MIN_DURATION_PERCENT=90

# Days to keep records of sent videos in the SQLite database
RETENTION_DAYS=30

# Hours to keep alert history in the database to prevent spamming
ALERT_RETENTION_HOURS=720

# If true, sends a new alert even if the specific time slot has failed before.
# If false, it fails silently after the first alert for a specific slot.
ALERT_REPEAT=false

# If true, when a failed video is finally sent successfully:
# 1. Edits the original error message to say "RESOLVED".
# 2. Sends a reply to that error message.
# 3. Adds a reaction (heart) to the error message.
NOTIFY_ON_RECOVERY=true

# ==============================================================================
# SYSTEM & PERFORMANCE
# ==============================================================================
# Maximum number of cameras to process simultaneously (prevents high CPU/IO)
MAX_CONCURRENT_TASKS=5

# Number of seconds to add before/after the requested timestamp to ensure full coverage
PADDING_SEC=5

# Maximum number of retries for Telegram API network requests
MAX_RETRIES=5

# Test mode duration (in minutes) - only used when MODE=test
TEST_REC_DURATION_MIN=1